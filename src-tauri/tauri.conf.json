{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "apisender",
  "version": "0.1.15",
  "identifier": "io.dxx.apisender",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "apisender",
        "titleBarStyle": "Visible",
        "decorations": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dxx/apisender/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxODVCRDk5MTk3QjlEOTgKUldTWW5Yc1ptYjJGZ1JCWjZ1K09CZUpPbCtYcnE0T2Q5bXBOVWNoTHd3dWdwSlhzYlBOQlJyV2UK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
